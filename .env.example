# Local development only. EAS builds read these from expo.dev →
# lingoyun → Environment variables. .env is git-ignored.

# Sentry → lingoyun → Settings → Client Keys (DSN). Bundled into the app.
EXPO_PUBLIC_SENTRY_DSN=

# Sentry → Settings → Auth Tokens. Build-time only (source map upload); never bundled.
SENTRY_AUTH_TOKEN=
